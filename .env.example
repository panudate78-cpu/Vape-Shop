# Dr Cloud Vape Shop — environment
# Copy this file to .env and fill in values.

# PostgreSQL (use Neon for production — one Neon project, branch per env)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Session secret (use `openssl rand -base64 32` to generate)
SESSION_PASSWORD=change-me-to-a-long-random-string-at-least-32-chars

# Payment gateway: mock | authorize_net | nmi | square | viva
PAYMENT_GATEWAY=mock

# Age threshold (UK = 18)
NEXT_PUBLIC_AGE_THRESHOLD=18

# Optional gateway keys (only needed when switching off mock)
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_TRANSACTION_KEY=
# NMI_SECURITY_KEY=
# SQUARE_ACCESS_TOKEN=
# VIVA_API_KEY=
