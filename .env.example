# Dr Cloud Vape Shop — environment
# Copy this file to .env and fill in values.

# PostgreSQL (use Neon for production — one Neon project, branch per env)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Session secret (use `openssl rand -base64 32` to generate)
SESSION_PASSWORD=change-me-to-a-long-random-string-at-least-32-chars

# Payment gateway: mock | authorize_net | nmi | square | viva
PAYMENT_GATEWAY=mock

# Age threshold (UK = 18)
NEXT_PUBLIC_AGE_THRESHOLD=18

# Optional gateway keys (only needed when switching off mock)
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_TRANSACTION_KEY=
# NMI_SECURITY_KEY=
# SQUARE_ACCESS_TOKEN=
# VIVA_API_KEY=

# Transactional email (Resend) — https://resend.com
# Without RESEND_API_KEY, emails are logged to the server console instead of sent (safe for dev).
# RESEND_API_KEY=
# EMAIL_FROM=Dr Cloud <orders@yourdomain.co.uk>         # must be a verified sender/domain in Resend
# EMAIL_ADMIN_ALERTS_TO=you@gmail.com,shop@other.co.uk   # comma-separated list that gets new-order alerts
# EMAIL_REPLY_TO=support@yourdomain.co.uk                # optional reply-to address
# STORE_URL=https://vapeshop202626.vercel.app
# STORE_NAME=Dr Cloud Chessington
# STORE_PHONE=07947 357934
# STORE_ADDRESS=Unit 4, Bridge Road, Chessington KT9 2RT

# Production-only settings (item 10)
# WEBHOOK_SECRET=change-me-webhook-secret   # required in production; the mock webhook must send ?secret=<this>
# ALLOW_SEED=false                          # set true only to run the demo seed in production (creates demo accounts)
